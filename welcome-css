body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #d8b4fe, #a78bfa);
}

.welcome-box {
    padding: 30px;
}

h1 {
    font-size: 45px;
    margin-bottom: 15px;
}

p {
    font-size: 19px;
    margin-bottom: 30px;
}

button {
    padding: 13px 28px;
    font-size: 17px;
    font-weight: bold;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: #6d28d9;
    color: white;
}